PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:admin@localhost:5432/debitinfo?schema=public"

JWT_ACCESS_SECRET="your-jwt-access-secret"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:3000"
COOKIE_SECRET="your-fastify-cookie-secret-32-chars-long"

RSGE_SANDBOX_MODE="true"
RSGE_PUBLIC_KEY="your-rsge-public-key"
RSGE_SECRET_KEY="your-rsge-secret-key"
RSGE_SERVICE_URL="https://eservices.rs.ge"
RSGE_PUBLIC_INFO_URL="https://xdata.rs.ge/TaxPayer/RSPublicInfo"
