# ==========================================
# Debitinfo.GE Production & Render.com Environment
# ==========================================

# Port (Render sets this automatically, default is 4000 locally or 10000 on Render)
PORT=4000
NODE_ENV=production

# Layerbase PostgreSQL Database URL (Production)
DATABASE_URL="postgresql://postgres:ReGXjjgvKSey5Y3aCs48Frj4@debitinfo-worn-gear-pooler.sage.cloud.layerbase.dev:5432/debitinfo?sslmode=require"

# JWT Secrets for Authentication
JWT_ACCESS_SECRET="debitinfo-prod-access-secret-key-super-secure-2024"
JWT_REFRESH_SECRET="debitinfo-prod-refresh-secret-key-super-secure-2024"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Fastify Cookie Secure Secret (minimum 32 characters)
COOKIE_SECRET="debitinfo-fastify-cookie-secure-secret-32-bytes-prod"

# Allowed CORS Origins (comma-separated if multiple domains, e.g. Vercel frontend & custom domain)
CORS_ORIGIN="https://debitinfo.vercel.app,https://debitinfo.ge"

# RS.GE Integration (Sandbox mode enabled by default until live RS.GE certificate is provided)
RSGE_SANDBOX_MODE="true"
RSGE_PUBLIC_KEY="sandbox-rsge-public-key"
RSGE_SECRET_KEY="sandbox-rsge-secret-key"
RSGE_SERVICE_URL="https://eservices.rs.ge"
RSGE_PUBLIC_INFO_URL="https://xdata.rs.ge/TaxPayer/RSPublicInfo"
